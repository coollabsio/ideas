---
import type { Idea } from '~/lib/github';

interface Props {
  idea: Idea;
}

const { idea } = Astro.props;
const excerpt =
  idea.bodyText.length > 240 ? idea.bodyText.slice(0, 240).trimEnd() + '…' : idea.bodyText;
const date = new Date(idea.createdAt).toLocaleDateString(undefined, {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---
<article
  class="idea-card coolbox group flex-row gap-3 p-3"
  data-id={idea.id}
>
  <button
    type="button"
    class:list={[
      'upvote relative z-10 shrink-0 w-12 h-14 rounded-sm border flex flex-col items-center justify-center transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-coollabs dark:focus-visible:ring-warning focus-visible:ring-offset-2 focus-visible:ring-offset-white dark:focus-visible:ring-offset-base disabled:cursor-not-allowed disabled:opacity-50',
      idea.viewerHasUpvoted
        ? 'border-coollabs bg-coollabs-50 text-coollabs-200 dark:border-warning/50 dark:bg-warning/15 dark:text-warning'
        : 'border-neutral-200 bg-white text-neutral-500 hover:border-coollabs/40 hover:text-coollabs dark:border-coolgray-300 dark:bg-base dark:text-neutral-400 dark:hover:border-warning/40 dark:hover:text-warning',
    ]}
    data-issue-number={idea.number}
    data-upvoted={idea.viewerHasUpvoted ? '1' : '0'}
    aria-label={idea.viewerHasUpvoted ? 'Remove upvote' : 'Upvote'}
    aria-busy="true"
  >
    <svg aria-hidden="true" viewBox="0 0 24 24" class="upvote-icon h-3 w-3" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 5l-7 7M12 5l7 7M12 5v14"/>
    </svg>
    <span class="count mt-1 font-mono text-sm font-bold leading-none">{idea.upvoteCount}</span>
  </button>
  <div class="min-w-0 flex-1">
    <a
      href={idea.url}
      target="_blank"
      rel="noopener"
      class="box-title block text-base font-bold leading-snug hover:text-coollabs focus-visible:outline-none focus-visible:text-coollabs dark:hover:text-warning dark:focus-visible:text-warning before:absolute before:inset-0 before:content-['']"
    >
      {idea.title}
      {idea.closed && (
        <span class="ml-2 inline-block rounded-full border border-error/50 bg-error/10 px-2 py-0.5 align-middle text-xs font-bold uppercase tracking-wider text-error">
          Closed
        </span>
      )}
    </a>
    <p class="box-description mt-1 line-clamp-2">{excerpt}</p>
    <div class="mt-2 flex items-center gap-2 text-xs uppercase tracking-wide text-neutral-500">
      {idea.author && (
        <>
          <img src={idea.author.avatarUrl} alt="" class="h-4 w-4 rounded-full border border-neutral-200 dark:border-coolgray-300" />
          <span class="font-bold normal-case">{idea.author.login}</span>
          <span aria-hidden="true">·</span>
        </>
      )}
      <time datetime={idea.createdAt} class="font-mono normal-case">{date}</time>
      <span aria-hidden="true">·</span>
      <a href={idea.url} target="_blank" rel="noopener" class="relative z-10 font-mono normal-case hover:text-warning">#{idea.number}</a>
    </div>
  </div>
</article>
