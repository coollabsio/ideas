---
import IdeaCard from '~/components/IdeaCard.astro';
import { AuthSlot } from '~/components/AuthSlot.tsx';
import { config } from '~/lib/config';
import { listIdeas, type Idea } from '~/lib/github';
import '~/styles/global.css';

export const prerender = true;

let ideas: Idea[] = [];
let buildError: string | null = null;

const buildToken = process.env.GITHUB_TOKEN;
if (!buildToken) {
  buildError =
    'GITHUB_TOKEN not set at build time — list will load from /api/issues on the client.';
} else {
  try {
    ideas = await listIdeas(buildToken);
  } catch (err) {
    buildError = `Build-time fetch failed: ${(err as Error).message}`;
  }
}

const openIdeas = ideas.filter((i) => !i.closed);
const closedIdeas = ideas.filter((i) => i.closed);
const totalUpvotes = ideas.reduce((acc, i) => acc + i.upvoteCount, 0);
const githubLoginEnabled = config.githubLoginEnabled;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>coolLabs · Ideas</title>
    <meta
      name="description"
      content="Upvote ideas for cool open-source apps from the coolLabs community. Synced live with GitHub Issues."
    />
    <link rel="icon" type="image/png" href="/logo.png" />
    <link rel="apple-touch-icon" href="/logo.png" />
    <meta name="theme-color" content="#101010" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="coolLabs · Ideas" />
    <meta property="og:description" content="Upvote ideas for cool open-source apps from the coolLabs community. Synced live with GitHub Issues." />
    <meta property="og:site_name" content="coolLabs Ideas" />
    <meta property="og:image" content="/og-image.png" />
    <meta property="og:image:width" content="1024" />
    <meta property="og:image:height" content="512" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@coolifyio" />
    <meta name="twitter:title" content="coolLabs · Ideas" />
    <meta name="twitter:description" content="Upvote ideas for cool open-source apps from the coolLabs community." />
    <meta name="twitter:image" content="/og-image.png" />
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem('theme');
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          const dark =
            stored === 'dark' ||
            stored === null ||
            (stored === 'system' && prefersDark);
          document.documentElement.classList.toggle('dark', dark);
        } catch {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
    <script defer data-domain="ideas.coollabs.io" src="https://analytics.coollabs.io/js/script.js" is:inline></script>
  </head>
  <body class="scrollbar min-h-screen bg-gray-50 text-neutral-600 antialiased dark:bg-base dark:text-neutral-400">
    <script is:inline define:vars={{ githubLoginEnabled }}>
      window.__githubLoginEnabled = githubLoginEnabled;
    </script>
    <div class="mx-auto flex min-h-screen max-w-3xl flex-col">
      <header class="flex items-center justify-between border-b border-neutral-200 px-4 py-4 dark:border-coolgray-200 sm:px-6 lg:px-8">
        <a href="/" class="flex items-center gap-2">
          <span class="inline-block h-2 w-2 bg-coollabs dark:bg-warning"></span>
          <span class="text-sm font-bold uppercase tracking-widest text-black dark:text-white">
            Coollabs <span class="text-coollabs dark:text-warning">/</span> Ideas
          </span>
        </a>
        <AuthSlot githubLoginEnabled={githubLoginEnabled} client:load />
      </header>

      <main class="flex-1 p-4 sm:px-6 lg:px-8 lg:py-6">
        <section class="mb-12">
          <h1 class="mb-2 text-3xl font-bold text-black dark:text-white">Ideas worth building.</h1>
          <p class="max-w-xl text-sm leading-relaxed text-neutral-600 dark:text-neutral-400">
            Synced live with
            <a
              class="font-bold text-coollabs hover:underline dark:text-warning"
              href="https://github.com/coollabsio/ideas/issues"
              target="_blank"
              rel="noopener">GitHub Issues</a
            >. {githubLoginEnabled ? 'Sign in with GitHub to upvote.' : 'GitHub sign-in is temporarily disabled.'}
          </p>
          <dl class="mt-4 flex flex-wrap gap-2 sm:max-w-sm">
            <div class="box-static min-w-[9rem] flex-1 flex-col items-start justify-center px-3 py-2">
              <dt class="text-xs font-bold uppercase tracking-widest text-neutral-500">Ideas</dt>
              <dd data-stat="ideas" class="font-mono text-lg font-bold text-black dark:text-white">{openIdeas.length}</dd>
            </div>
            <div class="box-static min-w-[9rem] flex-1 flex-col items-start justify-center px-3 py-2">
              <dt class="text-xs font-bold uppercase tracking-widest text-neutral-500">Upvotes</dt>
              <dd data-stat="upvotes" class="font-mono text-lg font-bold text-black dark:text-white">{totalUpvotes}</dd>
            </div>
          </dl>
        </section>

        {
          buildError && (
            <div class="callout callout-warning mb-4 text-sm">
              <span class="font-bold text-warning-800 dark:text-warning-300">Notice ·</span> {buildError}
            </div>
          )
        }

        <div class="mb-3 flex items-center justify-between">
          <h2 class="text-sm font-bold uppercase tracking-widest text-neutral-700 dark:text-neutral-300">
            <span class="text-coollabs dark:text-warning">▸</span> All ideas
          </h2>
          <span class="font-mono text-xs text-neutral-500">sorted by upvotes</span>
        </div>

        <div id="ideas-list" class="space-y-2">
          {openIdeas.map((idea) => <IdeaCard idea={idea} />)}
        </div>

        {
          openIdeas.length === 0 && closedIdeas.length === 0 && !buildError && (
            <p class="rounded-sm border border-dashed border-neutral-300 px-4 py-8 text-center text-sm text-neutral-500 dark:border-coolgray-300">
              No ideas yet. Loading from GitHub…
            </p>
          )
        }

        {
          closedIdeas.length > 0 && (
            <details class="group mt-6">
              <summary class="flex cursor-pointer list-none items-center gap-2 border-t border-neutral-200 pt-4 text-sm font-bold uppercase tracking-widest text-neutral-500 hover:text-neutral-700 dark:border-coolgray-200 dark:hover:text-neutral-300">
                <span class="text-neutral-600 transition-transform group-open:rotate-90">▸</span>
                Closed ideas
                <span class="font-mono text-xs text-neutral-600">({closedIdeas.length})</span>
              </summary>
              <div id="closed-ideas-list" class="mt-3 space-y-2">
                {closedIdeas.map((idea) => <IdeaCard idea={idea} />)}
              </div>
            </details>
          )
        }
      </main>

      <footer class="border-t border-neutral-200 px-4 py-6 text-xs text-neutral-500 dark:border-coolgray-200 sm:px-6 lg:px-8">
        <div class="flex flex-wrap items-center justify-between gap-2">
          <span>
            Built with <a href="https://astro.build" class="text-neutral-700 hover:text-coollabs dark:text-neutral-300 dark:hover:text-warning">Astro</a> ·
            Powered by <a href="https://coolify.io?ref=coollabsideas" class="text-neutral-700 hover:text-coollabs dark:text-neutral-300 dark:hover:text-warning">Coolify</a>
          </span>
          <a
            href="https://github.com/coollabsio/ideas"
            target="_blank"
            rel="noopener"
            class="font-mono text-neutral-700 hover:text-coollabs dark:text-neutral-300 dark:hover:text-warning"
          >coollabsio/ideas</a>
        </div>
      </footer>
    </div>
    <script>
      import '~/components/ideas-island.ts';
    </script>
  </body>
</html>
