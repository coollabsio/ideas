# GitHub OAuth/App user authorization credentials.
# GitHub is used only for identity; ideas and upvotes live in local SQLite.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Set false to hide sign-in and block /api/auth/login.
GITHUB_LOGIN_ENABLED=true

# Public origin of this app. Must match the GitHub OAuth callback URL.
PUBLIC_BASE_URL=http://127.0.0.1:5173

# SQLite database location.
DB_PATH=./data/ideas.db

# Server bind address.
PORT=4321
HOST=0.0.0.0

# Optional during backend iteration: skip SvelteKit build in cargo build.
# IDEAS_SKIP_FRONTEND=1
