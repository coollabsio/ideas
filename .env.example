# GitHub App user authorization credentials (https://github.com/settings/apps/new)
# Use the GitHub App Client ID and Client secret. No OAuth scopes are requested in code.
# Required app repository permissions: Metadata read, Issues read/write.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Temporarily disable GitHub sign-in/new authenticated actions.
# Set to false to hide sign-in UI and block /api/auth/login.
GITHUB_LOGIN_ENABLED=true

# Fine-grained Personal Access Token scoped to `coollabsio/ideas` with `Issues: read`.
# The migration script also needs temporary issue write access.
# Used for build-time prerender + anonymous live refresh.
GITHUB_TOKEN=

# Public origin of the deployed app — must match the OAuth callback URL configured in GitHub.
PUBLIC_BASE_URL=http://localhost:4321

# SQLite location (defaults to ./data/sessions.db)
# DB_PATH=./data/sessions.db

# Server port (defaults to 4321)
PORT=4321
HOST=0.0.0.0
